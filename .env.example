# Copy to .env. Every setting has a default except the connection strings.
ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=5600
ANALYTICS_DATA_DIR=data
ANALYTICS_WAREHOUSE_PATH=data/warehouse.duckdb
ANALYTICS_DBT_PROJECT_DIR=dbt
# Phase 1: read-only login on FinancePowerApp (database/tools/analytics_reader.sql there).
# e.g. DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=FinancePowerApp;UID=analytics_reader;PWD=...;TrustServerCertificate=yes
ANALYTICS_FINANCE_CONNECTION_STRING=
# Phase 2: ClinicHub is the OIDC issuer.
ANALYTICS_OIDC_ISSUER=http://localhost:5301/
# Empty = {issuer}.well-known/jwks
ANALYTICS_OIDC_JWKS_URI=
# Empty = the token audience is not checked
ANALYTICS_OIDC_AUDIENCE=
# Origin of the dashboard (phase 3), allowed by CORS
ANALYTICS_WEB_ORIGIN=http://localhost:5601
# Phase 4: IntegrationHub's event feed. guest works only on the broker's own host; the account is in
# docs/architecture.md (The RabbitMQ account).
ANALYTICS_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
ANALYTICS_RABBITMQ_EXCHANGE=clinical.events
ANALYTICS_RABBITMQ_QUEUE=analytics.clinical-events
ANALYTICS_CONSUME_BATCH_SIZE=200
ANALYTICS_CONSUME_FLUSH_SECONDS=5.0
# Phase 6: how often `analytics schedule` runs extract + build + score (30m, 6h, 1d).
ANALYTICS_RUN_EVERY=6h
# Told (JSON POST with a `text` field) when a run fails and when it works again; empty = nobody.
ANALYTICS_ALERT_WEBHOOK_URL=
ANALYTICS_ALERT_REPEAT_HOURS=24
# Old data: finance extracts older than this many days keep one per day; reports kept. 0 = keep all.
ANALYTICS_KEEP_EXTRACT_DAYS=14
ANALYTICS_KEEP_REPORTS=200
